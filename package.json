{
  "name": "field-search",
  "version": "0.0.0",
  "private": false,
  "description": "Fielded search query language: string <-> AST, plus React rendering primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./layout.css": "./dist/layout.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsup",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "visual": "node --experimental-strip-types scripts/shoot.mts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "puppeteer": "^22.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
