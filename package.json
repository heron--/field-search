{
  "name": "field-search",
  "version": "0.1.0",
  "private": false,
  "description": "Fielded search query language: string <-> AST, plus React rendering primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heron--/field-search.git"
  },
  "homepage": "https://heron--.github.io/field-search/",
  "bugs": "https://github.com/heron--/field-search/issues",
  "keywords": [
    "search",
    "query",
    "query-language",
    "parser",
    "ast",
    "filter",
    "faceted-search",
    "search-input",
    "combobox",
    "contenteditable",
    "react"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/radix-popover": {
      "types": "./dist/react/radix-popover.d.ts",
      "import": "./dist/react/radix-popover.js",
      "default": "./dist/react/radix-popover.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsup",
    "playground:build": "vite build playground --outDir ../playground-dist --base /field-search/ --emptyOutDir",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "visual": "tsx scripts/shoot.mts --shots",
    "visual:check": "tsx scripts/shoot.mts",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-popover": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "puppeteer": "^22.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
